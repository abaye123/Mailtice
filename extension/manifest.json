{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Mailtice",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*"
  ],
  "key": ""
}
