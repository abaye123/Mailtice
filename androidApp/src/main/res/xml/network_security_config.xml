<?xml version="1.0" encoding="utf-8"?>
<!--
    Overrides the file of the same name inside netfreetools.certificates. An application resource
    wins over a library one, and both manifests name @xml/network_security_config, so the AAR still
    supplies every res/raw/netfree_*.crt referenced below while this file decides what is trusted.

    Kept as an app resource (rather than left to the AAR) so the trust decision is visible here.

    The trust anchors are copied verbatim from netfreetools.certificates 1.2.0:
    android-certificates/src/androidMain/res/xml/network_security_config.xml
    A version bump can add certificates. Diff that file against this one when bumping, otherwise a
    newly published NetFree root ships in the APK and is never trusted.
-->
<network-security-config>
    <base-config>
        <trust-anchors>
            <!-- Current unified NetFree roots (X2), see https://netfree.link/cacert/united/x2/ -->
            <certificates src="@raw/netfree_root_ca_x2_rsa" />
            <certificates src="@raw/netfree_root_ca_x2_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_x2_prime256v1" />
            <certificates src="@raw/netfree_root_ca_x2_secp384r1" />
            <certificates src="@raw/netfree_root_ca_x2_ed25519" />

            <!-- Legacy unified NetFree roots, still used by accounts not migrated to X2 -->
            <certificates src="@raw/netfree_root_ca_rsa" />
            <certificates src="@raw/netfree_root_ca_rsa_2037" />
            <certificates src="@raw/netfree_root_ca_prime256v1" />
            <certificates src="@raw/netfree_root_ca_secp384r1" />
            <certificates src="@raw/netfree_root_ca_ed25519" />

            <!-- Per ISP signing certificates from the previous generation -->
            <certificates src="@raw/netfree_bezeq" />
            <certificates src="@raw/netfree_018" />
            <certificates src="@raw/netfree_099" />
            <certificates src="@raw/netfree_amitnet" />
            <certificates src="@raw/netfree_hadran_vpn" />
            <certificates src="@raw/netfree_hot" />
            <certificates src="@raw/netfree_ib_itc" />
            <certificates src="@raw/netfree_ib_partner" />
            <certificates src="@raw/netfree_ib_spotnet" />
            <certificates src="@raw/netfree_itc" />
            <certificates src="@raw/netfree_simkasher_cellcom" />
            <certificates src="@raw/netfree_simkasher_itc" />
            <certificates src="@raw/netfree_simkasher_patner" />
            <certificates src="@raw/netfree_simkasher_pelephone" />
            <certificates src="@raw/netfree_simkasher_triplec" />
            <certificates src="@raw/netfree_yossitikshoret" />

            <!--
                Deliberately no <certificates src="user" />. The NetFree roots above cover a
                filtered line whether or not the device has the certificate installed, so trusting
                whatever else a user has added to the store would buy nothing and would let any
                interception CA on the device read this app's traffic.
            -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
