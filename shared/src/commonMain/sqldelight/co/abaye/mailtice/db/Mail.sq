-- One row per connected mailbox. Secrets (refresh tokens, IMAP passwords) are NOT stored here.
CREATE TABLE account (
  id TEXT NOT NULL PRIMARY KEY,
  kind TEXT NOT NULL,                  -- ProviderKind.name
  email TEXT NOT NULL,
  label TEXT NOT NULL DEFAULT '',
  color TEXT NOT NULL,
  notify INTEGER NOT NULL DEFAULT 1,
  retentionDays INTEGER NOT NULL DEFAULT 30,   -- 0 = everything
  capabilities TEXT NOT NULL DEFAULT '',       -- Capabilities.encode()
  imapHost TEXT,
  imapPort INTEGER,
  imapSecurity TEXT,                   -- ImapSecurity.name
  username TEXT,
  syncCursor TEXT NOT NULL DEFAULT '', -- Gmail historyId; unused for IMAP (per folder)
  sortOrder INTEGER NOT NULL DEFAULT 0,
  createdAt INTEGER NOT NULL
);

CREATE TABLE folder (
  accountId TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  id TEXT NOT NULL,                    -- Gmail label id or IMAP full name
  name TEXT NOT NULL,
  role TEXT NOT NULL,                  -- FolderRole.name
  sync INTEGER NOT NULL DEFAULT 0,
  notify INTEGER NOT NULL DEFAULT 0,
  uidValidity INTEGER NOT NULL DEFAULT 0,
  uidNext INTEGER NOT NULL DEFAULT 0,
  highestModSeq INTEGER NOT NULL DEFAULT 0,
  color TEXT NOT NULL DEFAULT '',      -- "#rrggbb" background colour the provider gives the label, '' = none
  PRIMARY KEY (accountId, id)
);

CREATE TABLE message (
  accountId TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  id TEXT NOT NULL,                    -- Gmail message id, or "<folder>/<uid>" for IMAP
  threadId TEXT NOT NULL DEFAULT '',
  uid INTEGER NOT NULL DEFAULT 0,
  fromName TEXT NOT NULL DEFAULT '',
  fromAddress TEXT NOT NULL DEFAULT '',
  toLine TEXT NOT NULL DEFAULT '',
  subject TEXT NOT NULL DEFAULT '',
  snippet TEXT NOT NULL DEFAULT '',
  receivedAt INTEGER NOT NULL,
  unread INTEGER NOT NULL DEFAULT 1,
  flagged INTEGER NOT NULL DEFAULT 0,
  hasAttachments INTEGER NOT NULL DEFAULT 0,
  sizeBytes INTEGER NOT NULL DEFAULT 0,
  notifiedAt INTEGER,
  PRIMARY KEY (accountId, id)
);

CREATE INDEX message_received ON message(receivedAt DESC);
CREATE INDEX message_unread ON message(accountId, unread);

CREATE TABLE message_folder (
  accountId TEXT NOT NULL,
  messageId TEXT NOT NULL,
  folderId TEXT NOT NULL,
  PRIMARY KEY (accountId, messageId, folderId),
  FOREIGN KEY (accountId, messageId) REFERENCES message(accountId, id) ON DELETE CASCADE
);

CREATE INDEX message_folder_folder ON message_folder(accountId, folderId);

-- Messages scheduled to be sent later. Sent by the app while it runs (Gmail's API has no scheduled send).
CREATE TABLE scheduled_mail (
  id TEXT NOT NULL PRIMARY KEY,
  accountId TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  sendAt INTEGER NOT NULL,             -- epoch millis; moved later after a failed attempt
  payload TEXT NOT NULL,               -- the outgoing message as JSON (ScheduledCodec)
  attempts INTEGER NOT NULL DEFAULT 0,
  lastError TEXT NOT NULL DEFAULT ''
);

-- What the user did while offline (offline mode), replayed in order when the connection is back.
CREATE TABLE pending_action (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  accountId TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  messageId TEXT NOT NULL,
  kind TEXT NOT NULL,                  -- PendingKind.name
  createdAt INTEGER NOT NULL
);

-- The addresses an account sends from (Gmail "Send mail as"), read from the provider.
CREATE TABLE sender_identity (
  accountId TEXT NOT NULL REFERENCES account(id) ON DELETE CASCADE,
  email TEXT NOT NULL,
  name TEXT NOT NULL DEFAULT '',
  replyTo TEXT NOT NULL DEFAULT '',
  signature TEXT NOT NULL DEFAULT '',
  isDefault INTEGER NOT NULL DEFAULT 0,
  sortOrder INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY (accountId, email)
);

CREATE TABLE message_body (
  accountId TEXT NOT NULL,
  messageId TEXT NOT NULL,
  textBody TEXT NOT NULL DEFAULT '',
  htmlBody TEXT NOT NULL DEFAULT '',
  attachments TEXT NOT NULL DEFAULT '', -- "name|size" per line
  PRIMARY KEY (accountId, messageId),
  FOREIGN KEY (accountId, messageId) REFERENCES message(accountId, id) ON DELETE CASCADE
);

-- Accounts -----------------------------------------------------------------------------------

selectAccounts:
SELECT * FROM account ORDER BY sortOrder, createdAt;

selectAccount:
SELECT * FROM account WHERE id = ?;

setAccountOrder:
UPDATE account SET sortOrder = ? WHERE id = ?;

-- Plain INSERT, never REPLACE: a REPLACE deletes the row first, and the cascade would take every
-- message of the account with it.
insertAccount:
INSERT INTO account(id, kind, email, label, color, notify, retentionDays, capabilities,
  imapHost, imapPort, imapSecurity, username, syncCursor, sortOrder, createdAt)
VALUES ?;

updateAccountServer:
UPDATE account SET imapHost = ?, imapPort = ?, imapSecurity = ?, username = ? WHERE id = ?;

updateAccountPrefs:
UPDATE account SET label = ?, color = ?, notify = ?, retentionDays = ? WHERE id = ?;

updateAccountCursor:
UPDATE account SET syncCursor = ? WHERE id = ?;

updateAccountCapabilities:
UPDATE account SET capabilities = ? WHERE id = ?;

deleteAccount:
DELETE FROM account WHERE id = ?;

-- Folders ------------------------------------------------------------------------------------

selectFolders:
SELECT * FROM folder WHERE accountId = ? ORDER BY CASE role WHEN 'Inbox' THEN 0 ELSE 1 END, name;

selectAllFolders:
SELECT * FROM folder;

-- No UPSERT anywhere: Android 8-10 ship SQLite 3.18/3.22, which predate it (3.24).
insertFolderIfMissing:
INSERT OR IGNORE INTO folder(accountId, id, name, role, sync, notify, color) VALUES (?, ?, ?, ?, ?, ?, ?);

renameFolder:
UPDATE folder SET name = ?, role = ?, color = ? WHERE accountId = ? AND id = ?;

setFolderPrefs:
UPDATE folder SET sync = ?, notify = ? WHERE accountId = ? AND id = ?;

setFolderState:
UPDATE folder SET uidValidity = ?, uidNext = ?, highestModSeq = ? WHERE accountId = ? AND id = ?;

deleteFolder:
DELETE FROM folder WHERE accountId = ? AND id = ?;

-- Messages -----------------------------------------------------------------------------------

insertMessageIfMissing:
INSERT OR IGNORE INTO message(accountId, id, threadId, uid, fromName, fromAddress, toLine, subject, snippet,
  receivedAt, unread, flagged, hasAttachments, sizeBytes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectMessage:
SELECT * FROM message WHERE accountId = ? AND id = ?;

linkFolder:
INSERT OR IGNORE INTO message_folder(accountId, messageId, folderId) VALUES (?, ?, ?);

unlinkFolder:
DELETE FROM message_folder WHERE accountId = ? AND messageId = ? AND folderId = ?;

setFlags:
UPDATE message SET unread = ?, flagged = ? WHERE accountId = ? AND id = ?;

setUnread:
UPDATE message SET unread = ? WHERE accountId = ? AND id = ?;

markNotified:
UPDATE message SET notifiedAt = ? WHERE accountId = ? AND id = ?;

deleteMessage:
DELETE FROM message WHERE accountId = ? AND id = ?;

-- A Gmail conversation, oldest first, with each message's folders.
selectThread:
SELECT m.*, (
  SELECT group_concat(mf2.folderId, char(31)) FROM message_folder mf2
  WHERE mf2.accountId = m.accountId AND mf2.messageId = m.id
) AS folderIds
FROM message m WHERE m.accountId = ? AND m.threadId = ? ORDER BY m.receivedAt;

-- Several Gmail conversations at once, oldest first: the list's conversation view.
selectThreads:
SELECT m.*, (
  SELECT group_concat(mf2.folderId, char(31)) FROM message_folder mf2
  WHERE mf2.accountId = m.accountId AND mf2.messageId = m.id
) AS folderIds
FROM message m WHERE m.accountId = ? AND m.threadId IN ? ORDER BY m.receivedAt;

-- An account's mail without a thread id (IMAP), oldest first: conversation view groups it by subject in code.
selectUnthreaded:
SELECT m.*, (
  SELECT group_concat(mf2.folderId, char(31)) FROM message_folder mf2
  WHERE mf2.accountId = m.accountId AND mf2.messageId = m.id
) AS folderIds
FROM message m WHERE m.accountId = ? AND m.threadId = '' ORDER BY m.receivedAt;

-- IMAP has no thread id: candidates by subject, narrowed in code (ThreadExport.baseSubject).
selectBySubject:
SELECT m.*, (
  SELECT group_concat(mf2.folderId, char(31)) FROM message_folder mf2
  WHERE mf2.accountId = m.accountId AND mf2.messageId = m.id
) AS folderIds
FROM message m WHERE m.accountId = ? AND m.subject LIKE '%' || ? || '%' ORDER BY m.receivedAt;

-- Scheduled send ------------------------------------------------------------------------------

selectScheduled:
SELECT * FROM scheduled_mail ORDER BY sendAt;

selectDueScheduled:
SELECT * FROM scheduled_mail WHERE sendAt <= ? ORDER BY sendAt;

insertScheduled:
INSERT OR REPLACE INTO scheduled_mail(id, accountId, sendAt, payload, attempts, lastError) VALUES (?, ?, ?, ?, 0, '');

deleteScheduled:
DELETE FROM scheduled_mail WHERE id = ?;

failScheduled:
UPDATE scheduled_mail SET attempts = attempts + 1, lastError = ?, sendAt = ? WHERE id = ?;

-- People mail came from, most recent first: the compose window's address suggestions.
selectContacts:
SELECT fromName, fromAddress FROM message
WHERE fromAddress <> '' AND (fromAddress LIKE '%' || :q || '%' OR fromName LIKE '%' || :q || '%')
GROUP BY lower(fromAddress)
ORDER BY max(receivedAt) DESC
LIMIT 8;

folderIdsOfMessage:
SELECT folderId FROM message_folder WHERE accountId = ? AND messageId = ?;

upsertBody:
INSERT OR REPLACE INTO message_body(accountId, messageId, textBody, htmlBody, attachments) VALUES ?;

selectBody:
SELECT * FROM message_body WHERE accountId = ? AND messageId = ?;

hasBody:
SELECT count(*) FROM message_body WHERE accountId = ? AND messageId = ?;

messageIdsInFolder:
SELECT messageId FROM message_folder WHERE accountId = ? AND folderId = ?;

-- The unified list: messages in a synced folder of the requested role (Inbox, Sent, Spam...) or in
-- one given folder. :accountId / :folderId / :role empty = no filter on that.
selectInbox:
SELECT m.*, (
  SELECT group_concat(mf2.folderId, char(31)) FROM message_folder mf2
  WHERE mf2.accountId = m.accountId AND mf2.messageId = m.id
) AS folderIds
FROM message m
WHERE EXISTS (
  SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
  WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.sync = 1
    AND (:folderId = '' OR mf.folderId = :folderId)
    AND (:role = '' OR f.role = :role)
)
AND (:accountId = '' OR m.accountId = :accountId)
AND (:unreadOnly = 0 OR m.unread = 1)
AND (:flaggedOnly = 0 OR m.flagged = 1)
AND (:readOnly = 0 OR m.unread = 0)
AND (:fromQ = '' OR m.fromName LIKE '%' || :fromQ || '%' OR m.fromAddress LIKE '%' || :fromQ || '%')
AND (:toQ = '' OR m.toLine LIKE '%' || :toQ || '%')
AND (:subjectQ = '' OR m.subject LIKE '%' || :subjectQ || '%')
AND (:after = 0 OR m.receivedAt >= :after)
AND (:before = 0 OR m.receivedAt < :before)
-- Up to four words, each in subject, sender, snippet or stored body; two excluded words.
AND (:w1 = '' OR m.subject LIKE '%' || :w1 || '%' OR m.fromName LIKE '%' || :w1 || '%'
     OR m.fromAddress LIKE '%' || :w1 || '%' OR m.snippet LIKE '%' || :w1 || '%'
     OR EXISTS (SELECT 1 FROM message_body b WHERE b.accountId = m.accountId AND b.messageId = m.id
                AND b.textBody LIKE '%' || :w1 || '%'))
AND (:w2 = '' OR m.subject LIKE '%' || :w2 || '%' OR m.fromName LIKE '%' || :w2 || '%'
     OR m.fromAddress LIKE '%' || :w2 || '%' OR m.snippet LIKE '%' || :w2 || '%'
     OR EXISTS (SELECT 1 FROM message_body b WHERE b.accountId = m.accountId AND b.messageId = m.id
                AND b.textBody LIKE '%' || :w2 || '%'))
AND (:w3 = '' OR m.subject LIKE '%' || :w3 || '%' OR m.fromName LIKE '%' || :w3 || '%'
     OR m.fromAddress LIKE '%' || :w3 || '%' OR m.snippet LIKE '%' || :w3 || '%'
     OR EXISTS (SELECT 1 FROM message_body b WHERE b.accountId = m.accountId AND b.messageId = m.id
                AND b.textBody LIKE '%' || :w3 || '%'))
AND (:w4 = '' OR m.subject LIKE '%' || :w4 || '%' OR m.fromName LIKE '%' || :w4 || '%'
     OR m.fromAddress LIKE '%' || :w4 || '%' OR m.snippet LIKE '%' || :w4 || '%'
     OR EXISTS (SELECT 1 FROM message_body b WHERE b.accountId = m.accountId AND b.messageId = m.id
                AND b.textBody LIKE '%' || :w4 || '%'))
AND (:x1 = '' OR (m.subject NOT LIKE '%' || :x1 || '%' AND m.fromName NOT LIKE '%' || :x1 || '%'
     AND m.fromAddress NOT LIKE '%' || :x1 || '%' AND m.snippet NOT LIKE '%' || :x1 || '%'))
AND (:x2 = '' OR (m.subject NOT LIKE '%' || :x2 || '%' AND m.fromName NOT LIKE '%' || :x2 || '%'
     AND m.fromAddress NOT LIKE '%' || :x2 || '%' AND m.snippet NOT LIKE '%' || :x2 || '%'))
AND (:attachmentsOnly = 0 OR m.hasAttachments = 1)
ORDER BY m.receivedAt DESC
LIMIT :limit;

-- Unread in the inbox only: spam, trash and sent mail never raise the badge.
unreadCounts:
SELECT m.accountId, count(*) AS unread FROM message m
WHERE m.unread = 1 AND EXISTS (
  SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
  WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.sync = 1 AND f.role = 'Inbox'
)
GROUP BY m.accountId;

-- Unread per synced folder, for the counts next to each folder in the sidebar.
unreadByFolder:
SELECT mf.accountId, mf.folderId, count(*) AS unread FROM message_folder mf
JOIN message m ON m.accountId = mf.accountId AND m.id = mf.messageId
JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
WHERE m.unread = 1 AND f.sync = 1
GROUP BY mf.accountId, mf.folderId;

-- Candidates for a notification: unread, never notified, in a folder with notifications on.
selectToNotify:
SELECT m.* FROM message m
WHERE m.accountId = ? AND m.unread = 1 AND m.notifiedAt IS NULL AND EXISTS (
  SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
  WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.notify = 1
)
ORDER BY m.receivedAt;

markAllNotified:
UPDATE message SET notifiedAt = ? WHERE accountId = ? AND notifiedAt IS NULL;

-- Retention ----------------------------------------------------------------------------------

pruneOlderThan:
DELETE FROM message WHERE accountId = ? AND receivedAt < ?;

-- Messages left with no synced folder (folder unticked, or label removed).
pruneOrphans:
DELETE FROM message WHERE accountId = ? AND NOT EXISTS (
  SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
  WHERE mf.accountId = message.accountId AND mf.messageId = message.id AND f.sync = 1
);

clearFolderLinks:
DELETE FROM message_folder WHERE accountId = ? AND folderId = ?;

clearAccountMail:
DELETE FROM message WHERE accountId = ?;

-- Storage ------------------------------------------------------------------------------------

-- Approximate bytes per account: the text columns that carry the weight.
storagePerAccount:
SELECT a.id AS accountId,
  (SELECT coalesce(sum(length(m.subject) + length(m.snippet) + length(m.fromName) + length(m.fromAddress)
     + length(m.toLine) + 64), 0) FROM message m WHERE m.accountId = a.id)
  + (SELECT coalesce(sum(length(b.textBody) + length(b.htmlBody) + length(b.attachments)), 0)
     FROM message_body b WHERE b.accountId = a.id) AS bytes,
  (SELECT count(*) FROM message m WHERE m.accountId = a.id) AS messages
FROM account a;

-- Every stored message's time since :since, and whether it sits in a Sent folder: what the smart
-- check learns an account's week from.
activityTimes:
SELECT m.receivedAt,
  EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Sent'
  ) AS sent
FROM message m
WHERE m.accountId = :accountId AND m.receivedAt >= :since;

-- The newest sent and the newest received message of an account.
latestActivity:
SELECT
  (SELECT MAX(m.receivedAt) FROM message m
     JOIN message_folder mf ON mf.accountId = m.accountId AND mf.messageId = m.id
     JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
   WHERE m.accountId = :accountId AND f.role = 'Sent') AS lastSent,
  (SELECT MAX(m.receivedAt) FROM message m
     JOIN message_folder mf ON mf.accountId = m.accountId AND mf.messageId = m.id
     JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
   WHERE m.accountId = :accountId AND f.role = 'Inbox') AS lastIncoming;

insertPending:
INSERT INTO pending_action(accountId, messageId, kind, createdAt) VALUES (?, ?, ?, ?);

selectPending:
SELECT id, messageId, kind FROM pending_action WHERE accountId = ? ORDER BY id;

deletePending:
DELETE FROM pending_action WHERE id = ?;

countPending:
SELECT count(*) FROM pending_action;

-- Offline mode: the newest messages still without a stored body.
messageIdsWithoutBody:
SELECT m.id FROM message m
WHERE m.accountId = :accountId
  AND NOT EXISTS (SELECT 1 FROM message_body b WHERE b.accountId = m.accountId AND b.messageId = m.id)
ORDER BY m.receivedAt DESC
LIMIT :limit;

-- Offline mode: messages with attachments, newest first, to download their files.
messageIdsWithAttachments:
SELECT m.id FROM message m
WHERE m.accountId = :accountId AND m.hasAttachments = 1
ORDER BY m.receivedAt DESC;

-- The home dashboard, per account: unread in the inbox, how many of them came since :since, and
-- when the newest unread and the newest message of all arrived.
digestCounts:
SELECT
  (SELECT count(*) FROM message m WHERE m.accountId = :accountId AND m.unread = 1 AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  )) AS unread,
  (SELECT count(*) FROM message m WHERE m.accountId = :accountId AND m.unread = 1 AND m.receivedAt >= :since AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  )) AS unreadRecent,
  (SELECT MAX(m.receivedAt) FROM message m WHERE m.accountId = :accountId AND m.unread = 1 AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  )) AS newestUnread,
  (SELECT MAX(m.receivedAt) FROM message m WHERE m.accountId = :accountId AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  )) AS newestAny;

-- The newest unread inbox messages of an account.
digestUnreadIds:
SELECT m.id FROM message m
WHERE m.accountId = :accountId AND m.unread = 1 AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  )
ORDER BY m.receivedAt DESC
LIMIT :limit;

-- Inbox arrival times since :since, for the dashboard's week of bars.
digestArrivals:
SELECT m.receivedAt FROM message m
WHERE m.accountId = :accountId AND m.receivedAt >= :since AND EXISTS (
    SELECT 1 FROM message_folder mf JOIN folder f ON f.accountId = mf.accountId AND f.id = mf.folderId
    WHERE mf.accountId = m.accountId AND mf.messageId = m.id AND f.role = 'Inbox'
  );

selectIdentities:
SELECT * FROM sender_identity ORDER BY accountId, sortOrder;

deleteIdentities:
DELETE FROM sender_identity WHERE accountId = ?;

insertIdentity:
INSERT OR REPLACE INTO sender_identity(accountId, email, name, replyTo, signature, isDefault, sortOrder) VALUES (?, ?, ?, ?, ?, ?, ?);

